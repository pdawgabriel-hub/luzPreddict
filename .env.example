# Copia este fichero a .env y descomenta lo que quieras cambiar.
# Todas las variables son opcionales: sin ellas se usan los valores por defecto.

# TIMEZONE=Europe/Madrid

# REE_API_URL=https://apidatos.ree.es/es/datos
# REE_TIMEOUT_SECONDS=30
# REE_MAX_DAYS_PER_REQUEST=28
# HISTORY_START=2021-06-01

# DATA_DIR=./data
# MODELS_DIR=./models

# PostgreSQL. En local, un servidor propio; en producción, Neon (cadena "pooled")
# DATABASE_URL=postgresql+psycopg://luz:luz@localhost:5433/luzpreddict
# Base de datos que vacían los tests: distinta de la anterior y terminada en _test
# TEST_DATABASE_URL=postgresql+psycopg://luz:luz@localhost:5433/luzpreddict_test
